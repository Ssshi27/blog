---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../lib/posts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`页面不存在 | ${SITE_TITLE}`} description="404 页面" />
		<style>
			main {
				text-align: center;
				padding: 4em 1em;
			}
			.code {
				font-size: 4em;
				font-weight: 700;
				color: var(--accent);
				margin: 0;
			}
			.links {
				margin-top: 2em;
				display: flex;
				justify-content: center;
				gap: 1.5em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="code">404</p>
			<p>你要找的页面不存在，可能已被移动或归档。</p>
			<div class="links">
				<a href={url('/')}>返回首页</a>
				<a href={url('/blog')}>全部文章</a>
				<a href={url('/search')}>站内搜索</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
