---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts, url } from '../lib/posts';

const posts = await getPublishedPosts();
const recent = posts.slice(0, 6);

const usedCategories = [...new Set(posts.map((p) => p.data.category))];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero { max-width: 52rem; padding: 4.2rem 0 2rem; }
			.hero::before { display: block; margin-bottom: 1.15rem; color: var(--accent-dark); content: 'PERSONAL KNOWLEDGE BASE'; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .68rem; font-weight: 700; letter-spacing: .14em; }
			.hero h1 { max-width: 10ch; margin-bottom: .28em; }
			.hero p { max-width: 39rem; margin-bottom: 0; color: var(--ink-muted); font-size: 1.12rem; }
			.stats { display: flex; flex-wrap: wrap; gap: .75rem 1.6rem; margin-top: 2rem; color: var(--ink-muted); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .72rem; }
			.stats span { display: inline-flex; align-items: baseline; gap: .35rem; }
			.stats strong { color: #b47928; font-size: 1.1rem; }
			.section-title { display: flex; justify-content: space-between; align-items: end; gap: 1rem; padding-bottom: 1rem; border-bottom: 2px solid var(--ink); }
			.section-title h2 { margin: 0; font-size: clamp(1.55rem, 3vw, 2rem); }
			.section-title a { color: var(--accent-dark); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .72rem; font-weight: 700; text-decoration: none; }
			.posts { display: grid; gap: 0; }
			.categories { display: flex; flex-wrap: wrap; gap: .55rem; }
			.categories a { padding: .45rem .7rem; border: 1px solid var(--line); color: var(--ink-muted); background: rgba(255, 255, 255, .46); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .72rem; text-decoration: none; transition: color 160ms ease, border-color 160ms ease, background 160ms ease; }
			.categories a:hover { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-dark); }
			.empty { padding: 2rem 0; color: var(--ink-muted); }
			@media (max-width: 620px) { .hero { padding-top: 1.5rem; } .stats { gap: .55rem 1rem; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
				<div class="stats">
					<span><strong>{posts.length}</strong> 篇已发布</span>
					<span><strong>{usedCategories.length}</strong> 个分类</span>
					<span><strong>{new Set(posts.flatMap((p) => p.data.tags)).size}</strong> 个标签</span>
				</div>
			</section>

			<section>
				<div class="section-title">
					<h2>最新文章</h2>
					<a href={url('/blog')}>查看全部 →</a>
				</div>
				{
					recent.length > 0 ? (
						<div class="posts">
							{recent.map((post) => (
								<PostCard post={post} />
							))}
						</div>
					) : (
						<div class="empty">
							还没有已发布的文章。运行 <code>npm run new:post</code> 创建第一篇吧。
						</div>
					)
				}
			</section>

			{
				usedCategories.length > 0 && (
					<section>
						<div class="section-title">
							<h2>分类</h2>
							<a href={url('/categories')}>全部分类 →</a>
						</div>
						<div class="categories">
							{usedCategories.map((c) => (
								<a href={url(`/categories/${c}/`)}>{CATEGORIES[c] ?? c}</a>
							))}
						</div>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
