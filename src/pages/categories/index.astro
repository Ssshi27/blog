---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';
import { getPublishedPosts, url } from '../../lib/posts';

const posts = await getPublishedPosts();
const counts = new Map<string, number>();
for (const post of posts) {
	counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
}
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`分类 | ${SITE_TITLE}`} description="按分类浏览文章" />
		<style>
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
				gap: 1em;
			}
			.card {
				padding: 1.2em;
				border: 1px solid rgba(var(--gray), 25%);
				border-radius: 10px;
				background: white;
				text-decoration: none;
				color: var(--black);
			}
			.card:hover {
				box-shadow: var(--box-shadow);
			}
			.card h3 {
				margin: 0 0 0.3em;
			}
			.card span {
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>分类</h1>
			<div class="grid">
				{
					categories.map(([slug, count]) => (
						<a class="card" href={url(`/categories/${slug}/`)}>
							<h3>{CATEGORIES[slug] ?? slug}</h3>
							<span>{count} 篇文章</span>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
