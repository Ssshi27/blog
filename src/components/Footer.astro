---
import { SITE_TITLE } from '../consts';
import { url } from '../lib/posts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p><strong>{SITE_TITLE}</strong> · 用 Markdown 沉淀可复用的学习记录。</p>
		<div class="footer-meta">
			<span>&copy; {today.getFullYear()}</span>
			<span>Astro 构建</span>
			<a href={url('/rss.xml')}>RSS 订阅</a>
			<a href={url('/sitemap-index.xml')}>站点地图</a>
		</div>
	</div>
</footer>
<style>
	footer { border-top: 1px solid var(--line); background: var(--paper-deep); }
	.footer-inner { display: flex; width: min(100% - 2.5rem, 1040px); margin: 0 auto; padding: 2rem 0 2.4rem; align-items: center; justify-content: space-between; gap: 1.5rem; color: var(--ink-muted); font-size: 0.8rem; }
	p { margin: 0; }
	strong { color: var(--ink); }
	.footer-meta { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.85rem 1rem; }
	a { color: inherit; text-decoration: none; }
	a:hover { color: var(--accent-dark); text-decoration: underline; text-underline-offset: 0.2em; }
	@media (max-width: 680px) { .footer-inner { width: min(100% - 2rem, 1040px); flex-direction: column; align-items: flex-start; } .footer-meta { justify-content: flex-start; } }
</style>
