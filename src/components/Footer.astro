---
import { SITE_TITLE } from '../consts';
import { url } from '../lib/posts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_TITLE} · 由 Markdown 自动构建 · 使用 Astro 驱动
	<div class="footer-links">
		<a href={url('/rss.xml')}>RSS 订阅</a>
		<a href={url('/sitemap-index.xml')}>站点地图</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-top: 1em;
	}
	.footer-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.footer-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
